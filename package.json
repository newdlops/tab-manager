        },
        {
          "command": "tabManager.explorer.copyRelativePath",
          "when": "view == tabManagerExplorer && viewItem =~ /^(file\\.ext\\.[^.]+|directory|workspaceFolder)$/",
          "group": "6_path@2"
        },
        {
          "command": "tabManager.explorer.selectForCompare",
          "when": "view == tabManagerExplorer && viewItem =~ /^file\\.ext\\.[^.]+$/",
          "group": "7_compare@1"
        },
        {
          "command": "tabManager.explorer.compareWithSelected",
          "when": "view == tabManagerExplorer && viewItem =~ /^file\\.ext\\.[^.]+$/ && tabManager.explorerHasCompareLeft",
          "group": "7_compare@2"
        },
        {
          "command": "tabManager.explorer.compareSelected",
          "when": "view == tabManagerExplorer && viewItem =~ /^file\\.ext\\.[^.]+$/ && listMultiSelection",
          "group": "7_compare@3"
        },
        {
          "command": "tabManager.explorer.compareWithBranch",
          "when": "view == tabManagerExplorer && viewItem =~ /^file\\.ext\\.[^.]+$/ && config.git.enabled && !git.missing && gitOpenRepositoryCount != 0",
          "group": "7_compare@4"
        },
        {
          "command": "tabManager.explorer.rename",
          "when": "view == tabManagerExplorer && viewItem =~ /^(file\\.ext\\.[^.]+|directory)$/",
          "group": "8_modify@1"
        },
        {
          "command": "tabManager.explorer.delete",
          "when": "view == tabManagerExplorer && viewItem =~ /^(file\\.ext\\.[^.]+|directory)$/",
          "group": "8_modify@2"
        },
        {
          "command": "tabManager.projects.open",
          "when": "view == tabManagerProjects && viewItem == project",
          "group": "navigation@1"
        },
        {
          "command": "tabManager.projects.remove",
          "when": "view == tabManagerProjects && viewItem == project",
          "group": "2_manage@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tabManager.explorer.rename",
        "key": "f2",
        "when": "focusedView == tabManagerExplorer"
      },
      {
        "command": "tabManager.explorer.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == tabManagerExplorer"
      },
      {
        "command": "tabManager.explorer.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == tabManagerExplorer"
      },
      {
        "command": "tabManager.explorer.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == tabManagerExplorer"
      },
      {
        "command": "tabManager.explorer.paste",
